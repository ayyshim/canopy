diff --git a/hub/internal/api/logos.go b/hub/internal/api/logos.go
new file mode 100644
index 0000000..1c078ff
--- /dev/null
+++ b/hub/internal/api/logos.go
@@ -0,0 +1,204 @@
+package api
+
+import (
+	"bytes"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"path"
+	"regexp"
+	"strings"
+
+	"canopy/hub/internal/authz"
+	"canopy/hub/internal/blob"
+	"canopy/hub/internal/core"
+	"canopy/hub/internal/httpx"
+	"canopy/hub/internal/store/db"
+)
+
+const maxLogoBytes = 1 << 20
+
+// logoTypes maps the detected content type to the stored file extension.
+var logoTypes = map[string]string{
+	"image/png": ".png", "image/jpeg": ".jpg", "image/webp": ".webp", "image/svg+xml": ".svg",
+}
+
+var errBadLogo = httpx.FieldError(http.StatusUnsupportedMediaType, "unsupported_logo", "logo", "Use a PNG, JPEG, SVG or WebP image.")
+
+// readLogo reads the request body and works out its type from the bytes, not the headers.
+func readLogo(w http.ResponseWriter, r *http.Request) ([]byte, string, error) {
+	data, err := io.ReadAll(http.MaxBytesReader(w, r.Body, maxLogoBytes))
+	if err != nil {
+		var tooBig *http.MaxBytesError
+		if errors.As(err, &tooBig) {
+			return nil, "", httpx.FieldError(http.StatusRequestEntityTooLarge, "logo_too_large", "logo", "The logo must be 1 MB or smaller.")
+		}
+		return nil, "", err
+	}
+	mime := http.DetectContentType(data)
+	if mime == "text/xml; charset=utf-8" || mime == "text/plain; charset=utf-8" {
+		if isSafeSVG(data) {
+			mime = "image/svg+xml"
+		}
+	}
+	if _, ok := logoTypes[mime]; !ok {
+		return nil, "", errBadLogo
+	}
+	return data, mime, nil
+}
+
+var svgHandler = regexp.MustCompile(`\won[a-z]+\s*=`)
+
+func isSafeSVG(data []byte) bool {
+	s := strings.ToLower(string(data))
+	return strings.Contains(s, "<svg") && !strings.Contains(s, "<script") && !strings.Contains(s, "javascript:") && !svgHandler.MatchString(s)
+}
+
+func (s *Server) saveLogo(r *http.Request, kind string, id interface{ String() string }, data []byte, mime string) (string, error) {
+	if s.Blobs == nil {
+		return "", errors.New("file storage is not configured")
+	}
+	key := fmt.Sprintf("logos/%s/%s/%s%s", kind, id, newID(), logoTypes[mime])
+	if err := s.Blobs.Put(r.Context(), key, bytes.NewReader(data), int64(len(data)), mime); err != nil {
+		return "", err
+	}
+	return key, nil
+}
+
+func (s *Server) serveLogo(w http.ResponseWriter, r *http.Request, key *string) error {
+	if key == nil || s.Blobs == nil {
+		return httpx.ErrNotFound
+	}
+	rc, size, err := s.Blobs.Get(r.Context(), *key)
+	if errors.Is(err, blob.ErrNotFound) {
+		return httpx.ErrNotFound
+	} else if err != nil {
+		return err
+	}
+	defer rc.Close()
+	for mime, ext := range logoTypes {
+		if ext == path.Ext(*key) {
+			w.Header().Set("Content-Type", mime)
+		}
+	}
+	w.Header().Set("Content-Length", fmt.Sprint(size))
+	w.Header().Set("Cache-Control", "private, max-age=31536000, immutable")
+	w.Header().Set("X-Content-Type-Options", "nosniff")
+	w.Header().Set("Content-Security-Policy", "default-src 'none'; style-src 'unsafe-inline'; sandbox")
+	_, _ = io.Copy(w, rc)
+	return nil
+}
+
+func (s *Server) handlePutOrgLogo(w http.ResponseWriter, r *http.Request) error {
+	orgID, err := pathID(r, "orgID")
+	if err != nil {
+		return err
+	}
+	if _, err := authz.OrgAdmin(r.Context(), s.Store.Queries, orgID, identity(r).UserID); err != nil {
+		return err
+	}
+	data, mime, err := readLogo(w, r)
+	if err != nil {
+		return err
+	}
+	key, err := s.saveLogo(r, "orgs", orgID, data, mime)
+	if err != nil {
+		return err
+	}
+	org, err := s.Store.SetOrganizationLogo(r.Context(), db.SetOrganizationLogoParams{ID: orgID, LogoKey: &key})
+	if err != nil {
+		return err
+	}
+	httpx.JSON(w, http.StatusOK, map[string]any{"organization": toOrgView(org)})
+	return nil
+}
+
+func (s *Server) handleGetOrgLogo(w http.ResponseWriter, r *http.Request) error {
+	orgID, err := pathID(r, "orgID")
+	if err != nil {
+		return err
+	}
+	if _, err := authz.OrgMember(r.Context(), s.Store.Queries, orgID, identity(r).UserID); err != nil {
+		return err
+	}
+	org, err := s.Store.GetOrganization(r.Context(), orgID)
+	if err != nil {
+		return err
+	}
+	return s.serveLogo(w, r, org.LogoKey)
+}
+
+func (s *Server) handleDeleteOrgLogo(w http.ResponseWriter, r *http.Request) error {
+	orgID, err := pathID(r, "orgID")
+	if err != nil {
+		return err
+	}
+	if _, err := authz.OrgAdmin(r.Context(), s.Store.Queries, orgID, identity(r).UserID); err != nil {
+		return err
+	}
+	if _, err := s.Store.SetOrganizationLogo(r.Context(), db.SetOrganizationLogoParams{ID: orgID}); err != nil {
+		return err
+	}
+	w.WriteHeader(http.StatusNoContent)
+	return nil
+}
+
+func (s *Server) handlePutWorkspaceLogo(w http.ResponseWriter, r *http.Request) error {
+	wsID, err := pathID(r, "wsID")
+	if err != nil {
+		return err
+	}
+	_, v, err := authz.LoadWorkspace(r.Context(), s.Store.Queries, wsID, identity(r).UserID)
+	if err != nil {
+		return err
+	}
+	if err := v.RequireAdmin(); err != nil {
+		return err
+	}
+	data, mime, err := readLogo(w, r)
+	if err != nil {
+		return err
+	}
+	key, err := s.saveLogo(r, "workspaces", wsID, data, mime)
+	if err != nil {
+		return err
+	}
+	ws, err := s.Store.SetWorkspaceLogo(r.Context(), db.SetWorkspaceLogoParams{ID: wsID, LogoKey: &key})
+	if err != nil {
+		return err
+	}
+	httpx.JSON(w, http.StatusOK, map[string]any{"workspace": core.ToWorkspace(ws)})
+	return nil
+}
+
+func (s *Server) handleGetWorkspaceLogo(w http.ResponseWriter, r *http.Request) error {
+	wsID, err := pathID(r, "wsID")
+	if err != nil {
+		return err
+	}
+	ws, _, err := authz.LoadWorkspace(r.Context(), s.Store.Queries, wsID, identity(r).UserID)
+	if err != nil {
+		return err
+	}
+	return s.serveLogo(w, r, ws.LogoKey)
+}
+
+func (s *Server) handleDeleteWorkspaceLogo(w http.ResponseWriter, r *http.Request) error {
+	wsID, err := pathID(r, "wsID")
+	if err != nil {
+		return err
+	}
+	_, v, err := authz.LoadWorkspace(r.Context(), s.Store.Queries, wsID, identity(r).UserID)
+	if err != nil {
+		return err
+	}
+	if err := v.RequireAdmin(); err != nil {
+		return err
+	}
+	if _, err := s.Store.SetWorkspaceLogo(r.Context(), db.SetWorkspaceLogoParams{ID: wsID}); err != nil {
+		return err
+	}
+	w.WriteHeader(http.StatusNoContent)
+	return nil
+}
diff --git a/hub/internal/api/logos_test.go b/hub/internal/api/logos_test.go
new file mode 100644
index 0000000..dd47a3e
--- /dev/null
+++ b/hub/internal/api/logos_test.go
@@ -0,0 +1,125 @@
+package api_test
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"strings"
+	"testing"
+
+	"canopy/hub/internal/auth"
+	"canopy/hub/internal/blob"
+)
+
+var pngBytes = append([]byte("\x89PNG\r\n\x1a\n"), make([]byte, 64)...)
+
+const svgText = `<svg xmlns="http://www.w3.org/2000/svg" width="8" height="8"><rect width="8" height="8"/></svg>`
+
+// putRaw sends a raw body and returns the status, headers and body bytes.
+func (c *client) putRaw(method, path string, body []byte) (int, http.Header, []byte) {
+	c.e.t.Helper()
+	req, _ := http.NewRequest(method, c.e.ts.URL+path, bytes.NewReader(body))
+	req.Header.Set("Content-Type", "application/octet-stream")
+	req.Header.Set("X-Forwarded-For", c.ip)
+	if method != http.MethodGet {
+		req.Header.Set(auth.CSRFHeader, c.csrf())
+	}
+	res, err := c.http.Do(req)
+	if err != nil {
+		c.e.t.Fatal(err)
+	}
+	defer res.Body.Close()
+	data, _ := io.ReadAll(res.Body)
+	return res.StatusCode, res.Header, data
+}
+
+func TestLogosOrgAndWorkspace(t *testing.T) {
+	e := newEnv(t)
+	e.srv.Blobs = blob.Dir{Root: t.TempDir()}
+	owner, me := e.signup("Logo Co")
+	org := currentOrg(me)
+	ws, _ := e.createWorkspace(owner, org, setupPayload())
+	outsider, _ := e.signup("Other Co")
+
+	// A staff member can see the logo but not change it.
+	r := owner.do("POST", "/api/v1/orgs/"+org+"/invites", map[string]any{"email": uniqueEmail("staff"), "role": "member",
+		"workspace_grants": []any{map[string]any{"workspace_id": ws, "role": "staff", "manager_ids": []string{}}}})
+	if r.Status != http.StatusCreated {
+		t.Fatalf("invite: %d %v", r.Status, r.Body)
+	}
+	token := strings.TrimPrefix(str(r.Body["link"]), "http://canopy.test/invite/")
+	staff := e.client()
+	if acc := staff.do("POST", "/api/v1/invites/"+token+"/accept", map[string]any{"name": "Sam", "password": "staff password"}); acc.Status != 200 {
+		t.Fatalf("accept: %d %v", acc.Status, acc.Body)
+	}
+
+	for _, tc := range []struct{ name, path string }{{"org", "/api/v1/orgs/" + org + "/logo"}, {"workspace", "/api/v1/workspaces/" + ws + "/logo"}} {
+		t.Run(tc.name, func(t *testing.T) {
+			if st, _, _ := owner.putRaw("GET", tc.path, nil); st != http.StatusNotFound {
+				t.Errorf("no logo yet: %d", st)
+			}
+			if st, _, _ := owner.putRaw("PUT", tc.path, pngBytes); st != http.StatusOK {
+				t.Fatalf("upload png: %d", st)
+			}
+			st, h, body := owner.putRaw("GET", tc.path, nil)
+			if st != 200 || h.Get("Content-Type") != "image/png" || !bytes.Equal(body, pngBytes) || !strings.Contains(h.Get("Cache-Control"), "max-age") {
+				t.Errorf("serve png: %d %q %q", st, h.Get("Content-Type"), h.Get("Cache-Control"))
+			}
+			if st, _, _ := owner.putRaw("PUT", tc.path, []byte(svgText)); st != http.StatusOK {
+				t.Errorf("upload svg: %d", st)
+			}
+			if _, h, _ := owner.putRaw("GET", tc.path, nil); h.Get("Content-Type") != "image/svg+xml" {
+				t.Errorf("svg type: %q", h.Get("Content-Type"))
+			}
+			if st, _, _ := owner.putRaw("PUT", tc.path, make([]byte, 1<<20+1)); st != http.StatusRequestEntityTooLarge {
+				t.Errorf("too large: %d", st)
+			}
+			if st, _, _ := owner.putRaw("PUT", tc.path, []byte("just some text")); st != http.StatusUnsupportedMediaType {
+				t.Errorf("wrong type: %d", st)
+			}
+			if st, _, _ := owner.putRaw("PUT", tc.path, []byte(`<svg><script>alert(1)</script></svg>`)); st != http.StatusUnsupportedMediaType {
+				t.Errorf("scripted svg: %d", st)
+			}
+			if st, _, _ := staff.putRaw("PUT", tc.path, pngBytes); st != http.StatusForbidden {
+				t.Errorf("staff upload: %d", st)
+			}
+			if st, _, _ := staff.putRaw("DELETE", tc.path, nil); st != http.StatusForbidden {
+				t.Errorf("staff delete: %d", st)
+			}
+			if st, _, _ := staff.putRaw("GET", tc.path, nil); st != 200 {
+				t.Errorf("staff view: %d", st)
+			}
+			if st, _, _ := outsider.putRaw("PUT", tc.path, pngBytes); st != http.StatusNotFound {
+				t.Errorf("outsider upload: %d", st)
+			}
+			if st, _, _ := outsider.putRaw("GET", tc.path, nil); st != http.StatusNotFound {
+				t.Errorf("outsider view: %d", st)
+			}
+		})
+	}
+
+	// logo_url shows up on the views.
+	m := owner.do("GET", "/api/v1/me", nil)
+	if str(m.Body["organizations"].([]any)[0].(map[string]any)["logo_url"]) == "" {
+		t.Errorf("me has no logo_url: %v", m.Body)
+	}
+	if str(owner.do("GET", "/api/v1/workspaces/"+ws, nil).Body["workspace"].(map[string]any)["logo_url"]) == "" {
+		t.Error("workspace has no logo_url")
+	}
+	list := owner.do("GET", "/api/v1/orgs/"+org+"/workspaces", nil)
+	if str(list.Body["workspaces"].([]any)[0].(map[string]any)["logo_url"]) == "" {
+		t.Errorf("list has no logo_url: %v", list.Body)
+	}
+
+	for _, p := range []string{"/api/v1/orgs/" + org + "/logo", "/api/v1/workspaces/" + ws + "/logo"} {
+		if st, _, _ := owner.putRaw("DELETE", p, nil); st != http.StatusNoContent {
+			t.Errorf("delete: %d", st)
+		}
+		if st, _, _ := owner.putRaw("GET", p, nil); st != http.StatusNotFound {
+			t.Errorf("after delete: %d", st)
+		}
+	}
+	if owner.do("GET", "/api/v1/orgs/"+org, nil).Body["organization"].(map[string]any)["logo_url"] != nil {
+		t.Error("logo_url still set after delete")
+	}
+}
